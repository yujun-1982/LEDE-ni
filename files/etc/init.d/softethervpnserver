#!/bin/sh /etc/rc.common

START=91
# STOP is what makes `enable` create the /etc/rc.d/K link, and /etc/inittab runs
# `rcS K shutdown` on reboot/halt. Without it stop_service() - and therefore the
# Flush - is never called at shutdown, so any change made in the last
# AutoSaveConfigSpan seconds was lost on a plain reboot (measured: hub created
# 30 s before `reboot` was gone afterwards).
STOP=10
USE_PROCD=1

# The package's own init script keeps its data directory in /var/softethervpn,
# but /var is a symlink to /tmp (tmpfs) on this image, and it only links
# vpn_server.config to the package's empty placeholder (files/dummy). So every
# listener, virtual hub and user lives in RAM and is gone after a reboot.
#
# This copy runs the server out of a real directory on the writable overlay
# instead, so the configuration survives reboots and sysupgrade.

STORE=/etc/softethervpn-server
STOCK=/usr/libexec/softethervpn

# SoftEther keeps hub/user/listener changes in memory. vpn_server.config is only
# rewritten when it is told to (the management command 'Flush'), when the daemon
# shuts down gracefully, or after AutoSaveConfigSpan seconds - which the shipped
# default sets to 86400 (24 h). /usr/libexec/softethervpn-set-autosave lowers it
# to the server's floor of 300 s. Flushing on stop makes every stop, and
# therefore every restart and every reboot (rc.d kill link), deterministic; a
# hard reset such as Proxmox' Restart now costs at most 5 minutes of changes.
#
# Once a server management password is set, Flush needs it. Keep it in
# /etc/softethervpn-server/management.password (root-only, never committed).
flush_conf() {
	[ -x /usr/libexec/softethervpn-flush ] || return 0
	pgrep -x vpnserver >/dev/null 2>&1 || return 0
	if ! /usr/libexec/softethervpn-flush >/dev/null 2>&1; then
		logger -t softethervpn5 "Flush at stop was refused - if a server management password is set, write it to ${STORE}/management.password (mode 600); until then a hard reset costs up to AutoSaveConfigSpan seconds of changes"
	fi
}

stop_service() {
	# Preferred: SoftEther's own graceful stop, which writes vpn_server.config
	# and - measured on the device - needs no management password, so it cannot
	# silently fail the way an unauthenticated 'Flush' does.
	#
	# 'vpnserver stop' only *asks*; the daemon keeps running for a second while it
	# saves. Returning immediately let the shutdown path tear everything down
	# before the write landed (measured: a hub created 10 s before a reboot was
	# still lost), so wait until the process is really gone.
	if [ -x "${STORE}/vpnserver" ] && pgrep -x vpnserver >/dev/null 2>&1; then
		oldpid=$(pgrep -x vpnserver | head -n 1)
		(cd "${STORE}" && ./vpnserver stop >/dev/null 2>&1)
		i=0
		while [ "${i}" -lt 15 ]; do
			# Gone, or replaced by procd's respawn: either way the original daemon
			# has finished saving.
			newpid=$(pgrep -x vpnserver | head -n 1)
			[ -z "${newpid}" ] && break
			[ "${newpid}" != "${oldpid}" ] && break
			sleep 1
			i=$((i + 1))
		done
	fi
	flush_conf
}

start_service() {
	mkdir -p -m 0755 "${STORE}"

	# vpnserver looks for hamcore.se2 and vpn_server.config next to the binary it
	# was started from, and that path is resolved through symlinks, so the binary
	# itself has to be a real file inside ${STORE}. It is only a stub that pulls in
	# libsoftethervpn-server.so, so copying it costs 12 KiB. Refreshed on every
	# start so a package upgrade cannot leave a stale binary behind.
	if [ ! -f "${STORE}/vpnserver" ] || ! cmp -s "${STOCK}/vpnserver" "${STORE}/vpnserver"; then
		cp "${STOCK}/vpnserver" "${STORE}/vpnserver"
		chmod 0755 "${STORE}/vpnserver"
	fi

	# Read-only bulk data: link it, do not copy 5 MiB of hamcore onto the flash.
	[ -e "${STORE}/hamcore.se2" ] || ln -sf "${STOCK}/hamcore.se2" "${STORE}/"
	[ -e "${STORE}/lang.config" ] || ln -sf "${STOCK}/lang.config" "${STORE}/"

	# First start: seed an empty config, or rescue one written by the old
	# /var/softethervpn layout while this new script was being installed.
	if [ ! -s "${STORE}/vpn_server.config" ]; then
		if [ -f /var/softethervpn/vpn_server.config ] &&
		   [ ! -L /var/softethervpn/vpn_server.config ] &&
		   [ -s /var/softethervpn/vpn_server.config ]; then
			cp /var/softethervpn/vpn_server.config "${STORE}/"
			logger -t softethervpn5 "migrated /var/softethervpn/vpn_server.config into ${STORE}"
		else
			cp "${STOCK}/vpn_server.config" "${STORE}/vpn_server.config"
		fi
	fi

	logger -t softethervpn5 "starting vpnserver from ${STORE}"

	procd_open_instance
	procd_set_param env LANG=en_US.UTF-8
	procd_set_param cwd "${STORE}"
	procd_set_param command "${STORE}/vpnserver" start --foreground
	procd_set_param respawn
	procd_close_instance

	# Self-healing auto-save: the 24-hour default comes back whenever a
	# configuration is loaded from a file (VPN Server Manager) or restored from an
	# older device, and only the running server can change it - ConfigSet needs
	# authentication, so this has to happen after the daemon is up. Retry until the
	# server answers with the requested value; harmless when it already says 300,
	# since the block above then skips the whole thing.
	if ! grep -q 'AutoSaveConfigSpan 300' "${STORE}/vpn_server.config" 2>/dev/null; then
		(
			i=0
			while [ "${i}" -lt 8 ]; do
				sleep 5
				/usr/libexec/softethervpn-set-autosave 300 >/dev/null 2>&1 && break
				i=$((i + 1))
			done
			[ "${i}" -lt 8 ] || logger -t softethervpn5 "could not set AutoSaveConfigSpan to 300 - if a management password is set, write it to ${STORE}/management.password"
		) >/dev/null 2>&1 &
	fi
}
