#!/bin/sh
#
# 97-enable-softethervpn-server - autostart the SoftEther VPN server.
#
# softethervpn5-server installs an init script but does not enable it, so a
# fresh flash has the binaries and no listening server. The script is named
# 'softethervpnserver' with no hyphen - 'softethervpn-server' does not exist.
#
# Runs once on first boot and is then deleted by the uci-defaults framework.
#

INIT='/etc/init.d/softethervpnserver'
LOG='/tmp/uci-defaults-97-softethervpn.log'

{
	echo "=== $(date) 97-enable-softethervpn-server ==="

	if [ ! -x "${INIT}" ]; then
		echo "skip: ${INIT} not present (package not in this image)"
		exit 0
	fi

	"${INIT}" enable
	echo "enable rc=$?"

	# The boot-time symlink is what makes it survive a reboot.
	ls -l /etc/rc.d/*softethervpnserver 2>/dev/null || echo "FAIL: no /etc/rc.d link"

	# uci-defaults run after the boot sequence, so 'enable' alone would not
	# start the server until the next reboot.
	"${INIT}" start
	echo "start rc=$?"
	sleep 2
	# Match by process name, not argv: 'pgrep -f vpnserver' also matches any
	# shell whose command line merely mentions the service. procd runs
	# /var/softethervpn/vpnserver, so comm is 'vpnserver'.
	RUNNING=$(pgrep -x vpnserver 2>/dev/null || true)
	if [ -n "${RUNNING}" ]; then
		echo "running: yes (pid $(echo ${RUNNING} | tr '\n' ' '))"
	else
		echo "running: no - check with /etc/init.d/softethervpnserver status"
	fi
} > "${LOG}" 2>&1

exit 0
