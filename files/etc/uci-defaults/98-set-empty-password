#!/bin/sh
#
# 98-set-empty-password - leave root with no password so the web UI and SSH
# accept an empty login.
#
# Runs once on first boot and is then deleted by the uci-defaults framework.
#

# Blank the password field and unlock the account.
passwd -d root >/dev/null 2>&1
passwd -u root >/dev/null 2>&1

# Sanity check: the hash must be empty, not '!' or '*'.
if grep -q '^root:[^:]' /etc/shadow 2>/dev/null; then
	echo "98-set-empty-password: root still has a password hash" >&2
fi

exit 0
