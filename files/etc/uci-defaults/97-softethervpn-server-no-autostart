#!/bin/sh
#
# 97-softethervpn-server-no-autostart - leave the SoftEther VPN server off.
#
# softethervpn5-server installs an init script, and installing the package
# leaves a boot-time symlink /etc/rc.d/S91softethervpnserver in the image, so
# the server would autostart. This script removes that autostart and records
# the state; it never starts the server and never stops a running one.
#
# Why disable alone is enough on first boot: uci-defaults are executed from
# /etc/init.d/boot, whose rc.d link is S10boot, and rcorder walks the list in
# order - so the S91 symlink is gone before boot would honour it.
#
# After a config-preserving sysupgrade uci-defaults run again, which turns
# autostart back off; re-enable it on the VPN -> SoftEther VPN Service page if
# you want it to survive reboots.
#
# The script is named 'softethervpnserver' with no hyphen - the hyphenated
# 'softethervpn-server' does not exist.
#
# Runs once on first boot and is then deleted by the uci-defaults framework.
#

INIT='/etc/init.d/softethervpnserver'
LOG='/tmp/uci-defaults-97-softethervpn.log'

{
	echo "=== $(date) 97-softethervpn-server-no-autostart ==="

	if [ ! -x "${INIT}" ]; then
		echo "skip: ${INIT} not present (package not in this image)"
		exit 0
	fi

	"${INIT}" disable
	echo "disable rc=$?"

	if ls /etc/rc.d/*softethervpnserver >/dev/null 2>&1; then
		echo "FAIL: a boot-time symlink is still present"
	else
		echo "autostart: off (no /etc/rc.d link)"
	fi

	if pgrep -x vpnserver >/dev/null 2>&1; then
		# Match by process name, not argv: 'pgrep -f vpnserver' also matches any
		# shell whose command line merely mentions the service.
		echo "running: yes (pid $(pgrep -x vpnserver | tr '\n' ' ')) - left untouched"
	else
		echo "running: no"
	fi

	# files/etc/init.d/softethervpnserver stores the configuration in
	# /etc/softethervpn-server. /etc survives reboots on its own, but a sysupgrade
	# only carries over what base-files and this list name, so add it once.
	if [ -f /etc/sysupgrade.conf ] && ! grep -qx '/etc/softethervpn-server' /etc/sysupgrade.conf; then
		echo '/etc/softethervpn-server' >> /etc/sysupgrade.conf
		echo "sysupgrade backup: added /etc/softethervpn-server"
	fi
	echo "sysupgrade backup: $(grep -c '/etc/softethervpn-server' /etc/sysupgrade.conf 2>/dev/null || echo 0) entry"

	# SoftEther ships AutoSaveConfigSpan = 86400 s, so configuration changes stay
	# in RAM for up to a day unless something flushes them - a hard reset (for
	# example Proxmox' Restart) then discards them. The round trip needs a running
	# server, so start it briefly and leave it stopped again; autostart is already
	# disabled above, so this does not change the default.
	if [ -x /usr/libexec/softethervpn-set-autosave ]; then
		"${INIT}" start
		sleep 5
		/usr/libexec/softethervpn-set-autosave 300
		echo "autosave clamp rc=$?"
		"${INIT}" stop
		sleep 2
		echo "config AutoSaveConfigSpan: $(grep -a AutoSaveConfigSpan /etc/softethervpn-server/vpn_server.config 2>/dev/null | tr -d '\t\r')"
	else
		echo "autosave clamp: helper not present, server keeps the 86400 s default"
	fi

	echo "to start it:  /etc/init.d/softethervpnserver start"
	echo "             or VPN -> SoftEther VPN Service in the web UI"
	echo "to autostart: /etc/init.d/softethervpnserver enable"
} > "${LOG}" 2>&1

exit 0
