#!/bin/sh
#
# 98-set-root-password - give root the password "111111".
#
# Runs once on first boot and is then deleted by the uci-defaults framework.
#
# The hash is written straight into /etc/shadow because this image's busybox
# has the 'passwd' applet but not 'chpasswd', so the usual
# "echo 'root:pw' | chpasswd" recipe does not exist here, and 'passwd root'
# needs a tty. The hash is SHA-512 crypt ($6$), which musl libc accepts.
#

HASH='$6$LfoQHCB2.YQc1Qp6$/z/pvcKsAb9ohLRJ8FF36mw9WkLYvPtcQ8wg/WQ/8d5Xk/eT0zWNWkvRw59r6gT7vNXVCP7qL3tuL4aKWoLNm/'
LOG='/tmp/uci-defaults-98-root-password.log'

{
	echo "=== $(date) 98-set-root-password ==="

	if [ ! -f /etc/shadow ]; then
		echo "FAIL: /etc/shadow missing"
		exit 0
	fi

	# Replace only the password field, keeping the ageing columns intact.
	sed -i "s|^root:[^:]*:|root:${HASH}:|" /etc/shadow
	echo "sed rc=$?"

	# A '!' prefix would lock the account out again.
	passwd -u root >/dev/null 2>&1

	NEW=$(grep '^root:' /etc/shadow | cut -d: -f2)
	case "${NEW}" in
		'$6'$*)
			echo "ok: root now uses a SHA-512 hash (${#NEW} chars)"
			;;
		'')
			echo "FAIL: root password field is still empty"
			;;
		*)
			echo "FAIL: unexpected root field: ${NEW%%\$*}"
			;;
	esac

	# dropbear refuses blank passwords but accepts a set one; confirm the
	# service is up so SSH works after this boot.
	/etc/init.d/dropbear enabled 2>/dev/null && echo "dropbear: enabled" || echo "dropbear: not enabled"
} > "${LOG}" 2>&1

exit 0
