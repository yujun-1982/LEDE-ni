#
# seed.config - LEDE custom firmware package/target selection
#
# Base: official OpenWrt master (25.12+ series, apk package manager), x86/64.
# This file is copied to .config and expanded by 'make defconfig'.
#

# ============================================================
# Target system
# ============================================================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ============================================================
# Target Images
# ============================================================

# --- Partition sizes ---
CONFIG_TARGET_KERNEL_PARTSIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# --- Filesystem images: squashfs only ---
# squashfs-combined.img.gz is the PVE-importable deliverable.
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_BTRFS is not set
# CONFIG_TARGET_ROOTFS_JFFS2 is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set
# CONFIG_TARGET_ROOTFS_ISO is not set
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_EROTS is not set

# --- Bootloaders: GRUB, no EFI ---
# The EFI symbol is GRUB_EFI_IMAGES on current master and defaults to y; the
# old name EFI_IMAGES no longer exists, so writing "# CONFIG_EFI_IMAGES is not
# set" silently leaves EFI images enabled.
CONFIG_GRUB_IMAGES=y
# CONFIG_GRUB_EFI_IMAGES is not set
CONFIG_GRUB_CONSOLE=y
CONFIG_GRUB_BAUDRATE=115200
CONFIG_GRUB_BOOTOPTS="quiet loglevel=0"
# String symbols must be quoted: CONFIG_GRUB_TIMEOUT=0 is rejected and the
# default "5" comes back.
CONFIG_GRUB_TIMEOUT="0"
CONFIG_GRUB_TITLE="OpenWrt"
# GRUB_SERIAL and QCOW_IMAGES were removed from master; the serial device is
# now derived from GRUB_CONSOLE/GRUB_BAUDRATE and there is no QCOW2 option.

# --- Virtual disk formats: none (PVE uses the raw .img.gz) ---
# CONFIG_VDI_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set

# --- Compression ---
CONFIG_TARGET_IMAGES_GZIP=y
# CONFIG_TARGET_IMAGES_ZSTD is not set

# ============================================================
# LuCI web interface
# ============================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-compat=y

# ============================================================
# Theme - Argon (both repos are cloned by build.sh; see README)
# ============================================================
CONFIG_PACKAGE_luci-theme-argon=y
# Separate upstream repo (jerrykuku/luci-app-argon-config), not part of the
# theme repo. Adds 系统 -> Argon 设置.
CONFIG_PACKAGE_luci-app-argon-config=y

# ============================================================
# Simplified Chinese translations
#
# Listed per application on purpose. Do NOT replace this with
# CONFIG_LUCI_LANG_zh_Hans=y: luci.mk gives every hidden luci-i18n-*-zh-cn
# package 'DEFAULT:=LUCI_LANG_zh_Hans' together with an unconditional
# 'DEPENDS:=$(PKG_NAME)', so the master switch drags in every LuCI
# application in the feed, not just the ones we ship.
#
# luci-i18n-base covers luci-base plus the core status/system/network modules.
# OpenClash and NinjaRouter carry their own .lmo inside their .apk, so they
# need no entry here.
# ============================================================
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-softether-zh-cn=y
CONFIG_PACKAGE_luci-i18n-timecontrol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ============================================================
# Plugins
# ============================================================
CONFIG_PACKAGE_luci-app-passwall=y
# The LuCI app is named luci-app-softether (official luci feed); the VPN
# binaries softethervpn5-* come from the packages feed.
CONFIG_PACKAGE_luci-app-softether=y
CONFIG_PACKAGE_luci-app-timecontrol=y

# SoftEther VPN server. luci-app-softether only pulls in the client, so the
# server binary has to be selected explicitly. The package ships
# /etc/init.d/softethervpn-server; enable and start it after first boot.
CONFIG_PACKAGE_softethervpn5-server=y
# Optional: layer-2 bridge mode, only needed for virtual-HUB bridging
# CONFIG_PACKAGE_softethervpn5-bridge is not set

# ============================================================
# Flow offloading - official kernel/nftables implementation
# (enabled on the LAN zone in files/etc/config/firewall)
# ============================================================
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-nat=y

# ============================================================
# Runtime dependencies required by the pre-compiled OpenClash .apk
#
# The .apk declares: bash ca-bundle curl dnsmasq-full ip-full jsonfilter
# kmod-tun ruby ruby-yaml unzip. 'apk add <local file>' still resolves
# dependencies against the configured repositories, so anything not baked
# into the image has to be downloaded at first boot - which fails when the
# device has no uplink yet. Bake them all in.
# ============================================================
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y

# dnsmasq-full replaces the default mini dnsmasq (OpenClash needs it)
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
